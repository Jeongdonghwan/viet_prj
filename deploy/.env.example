# 운영 환경변수 — 서버의 /srv/glaos/.env 로 복사 후 실제 값 기입
SECRET_KEY=서버에서-랜덤-생성할-것
SQLALCHEMY_DATABASE_URI=mysql+pymysql://glaos:비밀번호@localhost/glaos?charset=utf8mb4

# 관리자 계정 (기본값 절대 사용 금지)
ADMIN_USERNAME=운영관리자ID
ADMIN_PASSWORD=강한비밀번호로교체

# 가입 접수 메일 (Gmail 사용 시 앱 비밀번호 필요)

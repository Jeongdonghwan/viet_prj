# systemd 서비스 — 서버의 /etc/systemd/system/glaos.service 로 복사
[Unit]
Description=K-GLOBAL LAOS Flask (gunicorn :8000)
After=network.target mariadb.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/glaos
EnvironmentFile=/var/www/glaos/.env
ExecStart=/var/www/glaos/venv/bin/gunicorn -c deploy/gunicorn.conf.py "app:create_app()"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
